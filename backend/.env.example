# Puerto de la API
PORT=4000
NODE_ENV=development

# Cadena de conexión a MongoDB (local o Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/sigca

# Clave para firmar los JWT: cámbiela por una cadena larga y aleatoria
JWT_SECRET=cambie_esta_clave_por_una_larga_y_aleatoria
JWT_EXPIRES_IN=8h

# Origen permitido para CORS (URL del frontend de Vue)
CORS_ORIGIN=http://localhost:5173

# Zona horaria del centro (Guatemala = -06:00, sin horario de verano)
TZ_OFFSET=-06:00
